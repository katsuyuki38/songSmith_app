OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
API_PORT=8788
VITE_API_BASE=http://localhost:8788
APP_BASE_URL=http://localhost:4173

# SongSmith Vocal API bridge
VOCAL_API_PORT=8790
VOCAL_ENGINE=voicevox

# Easiest singing backend: VOICEVOX ENGINE
VOICEVOX_ENGINE_URL=http://127.0.0.1:50021
VOICEVOX_SING_STYLE=6000
VOICEVOX_FRAME_STYLE=3001

# Optional advanced backend: OpenVPI DiffSinger
DIFFSINGER_ENGINE_URL=http://127.0.0.1:8800
DIFFSINGER_SPEAKER=
DIFFSINGER_LANG=ja
DIFFSINGER_TIMEOUT_MS=180000
DIFFSINGER_ROOT=/path/to/DiffSinger
DIFFSINGER_EXP=your_acoustic_model
DIFFSINGER_PYTHON=python
DIFFSINGER_CKPT=
DIFFSINGER_RENDER_TIMEOUT=180
